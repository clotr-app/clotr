{
  "name": "clotr",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.1",
  "publisher": "clotr-app",
  "icon": "icon.png",
  "repository": { "type": "git", "url": "https://github.com/clotr-app/clotr" },
  "homepage": "https://clotr.app/developers.html",
  "bugs": { "url": "https://github.com/clotr-app/clotr/issues" },
  "qna": "https://github.com/clotr-app/clotr/discussions",
  "keywords": ["secrets", "credentials", "api key", "api keys", "passwords", "tokens", "privacy", "pii", "ai", "ai coding assistants", "claude code", "copilot", "cursor", "windsurf", "vscodium", "kiro", "trae", "code-server", "gitpod", "gemini cli", "codex", "cline", "leak"],
  "engines": { "vscode": "^1.57.0" },
  "extensionKind": ["workspace"],
  "license": "AGPL-3.0-or-later",
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrustedWorkspaces%",
      "restrictedConfigurations": ["clotr.enabled", "clotr.minSeverity", "clotr.personalDetailsInFiles", "clotr.skipList"]
    }
  },
  "activationEvents": ["onStartupFinished", "onCommand:clotr.tryIt", "onCommand:clotr.checkClipboard", "onCommand:clotr.checkSelection", "onCommand:clotr.setupGuard", "onCommand:clotr.turnOnFile"],
  "galleryBanner": { "color": "#1A1221", "theme": "dark" },
  "categories": ["AI", "Linters", "Other"],
  "contributes": {
    "walkthroughs": [
      {
        "id": "clotr.start",
        "title": "%walkthroughTitle%",
        "description": "%walkthroughDescription%",
        "steps": [
          {
            "id": "clotr.start.what",
            "title": "%walkthroughWhatTitle%",
            "description": "%walkthroughWhatDescription%",
            "media": { "image": "icon.png", "altText": "%walkthroughWhatImageAlt%" }
          },
          {
            "id": "clotr.start.try",
            "title": "%walkthroughTryTitle%",
            "description": "%walkthroughTryDescription%",
            "media": { "image": "images/open-file-warning.png", "altText": "%walkthroughTryImageAlt%" },
            "completionEvents": ["onCommand:clotr.tryIt"]
          },
          {
            "id": "clotr.start.guard",
            "title": "%walkthroughGuardTitle%",
            "description": "%walkthroughGuardDescription%",
            "media": { "image": "images/guard-setup-preview.png", "altText": "%walkthroughGuardImageAlt%" },
            "completionEvents": ["onCommand:clotr.setupGuard"]
          }
        ]
      }
    ],
    "commands": [{"command":"clotr.tryIt","title":"%tryItCommand%"},{"command":"clotr.checkClipboard","title":"%checkClipboard%"},{"command":"clotr.checkSelection","title":"%checkSelection%"},{"command":"clotr.setupGuard","title":"%setupGuard%"},{"command":"clotr.turnOnFile","title":"%turnOnFileCommand%"}],
    "views": {"explorer": [{"id":"clotr.findings","name":"%findingsView%"}]},
    "menus": {"editor/context":[{"command":"clotr.checkSelection","group":"navigation@99"}]},
    "configuration": {"title":"Clotr","properties": {
      "clotr.enabled":{"type":"boolean","scope":"machine","default":true,"description":"%enabled%"},
      "clotr.minSeverity":{"type":"string","scope":"machine","enum":["low","medium","high"],"default":"medium","description":"%minSeverity%"},
      "clotr.personalDetailsInFiles":{"type":"boolean","scope":"machine","default":false,"description":"%personalDetailsInFiles%"},
      "clotr.skipList":{"type":"array","scope":"machine","items":{"type":"string"},"default":["**/.git/**","**/.svn/**","**/.hg/**","**/node_modules/**","**/bower_components/**","**/.next/**","**/.nuxt/**","**/.svelte-kit/**","**/.angular/**","**/.turbo/**","**/.parcel-cache/**","**/.yarn/**","**/.pnpm-store/**","**/__pycache__/**","**/site-packages/**","**/dist-packages/**","**/.pytest_cache/**","**/.mypy_cache/**","**/.ruff_cache/**","**/.tox/**","**/.nox/**","**/.eggs/**","**/.dart_tool/**","**/.pub-cache/**","**/.stack-work/**","**/elm-stuff/**","**/.terraform/**","**/DerivedData/**","**/.cache/**","**/.vs/**","**/*.egg-info/**","**/*.dist-info/**","**/package-lock.json","**/npm-shrinkwrap.json","**/pnpm-lock.yaml","**/yarn.lock","**/deno.lock","**/Pipfile.lock","**/poetry.lock","**/packages.lock.json","**/*.min.js","**/*.min.mjs","**/.env.example","**/.env.sample","**/.env.template","**/.env.dist"],"description":"%skipList%"}
    }}
  },
  "scripts": {"vscode:prepublish":"node build.js"}
}
