<idea-plugin>
    <id>app.clotr.jetbrains</id>
    <name>Clotr</name>
    <vendor>Clotr</vendor>
    <description>Check open files and copied text for private details before AI assistants can read them.</description>
    <depends>com.intellij.modules.platform</depends>
    <resource-bundle>messages.ClotrBundle</resource-bundle>
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Clotr Secret Files" displayType="BALLOON" isLogByDefault="false"/>
        <notificationGroup id="Clotr Guard" displayType="BALLOON" isLogByDefault="false"/>
        <projectService serviceImplementation="app.clotr.jetbrains.ClotrProjectService"/>
        <localInspection language="" shortName="ClotrPrivateDetails" displayName="Clotr private details"
                         groupName="Clotr" enabledByDefault="true" level="WARNING"
                         implementationClass="app.clotr.jetbrains.ClotrInspection"/>
        <statusBarWidgetFactory id="ClotrStatus" implementation="app.clotr.jetbrains.ClotrStatusWidgetFactory"/>
        <applicationConfigurable id="app.clotr.settings" displayName="Clotr"
                                 instance="app.clotr.jetbrains.ClotrSettingsConfigurable"/>
    </extensions>
    <actions>
        <action id="app.clotr.CheckClipboard" class="app.clotr.jetbrains.CheckClipboardAction">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="app.clotr.CheckSelection" class="app.clotr.jetbrains.CheckSelectionAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="app.clotr.GuardSetup" class="app.clotr.jetbrains.GuardSetupAction">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
