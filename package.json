{
  "name": "clotr",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Dev tooling for the Clotr extension (the extension itself is in extension/ and has no dependencies).",
  "scripts": {
    "test": "node --test --test-reporter=dot \"tests/*.test.js\"",
    "test:e2e": "node tests/e2e/run.js",
    "test:e2e:packaged": "node tools/package.js --no-zip --folder dist/e2e-packaged && node tests/e2e/run.js --ext dist/e2e-packaged",
    "test:firefox": "node tests/e2e/firefox.js",
    "test:stress": "node tests/e2e/run.js --stress --only STS",
    "lint": "prettier --check . && eslint .",
    "coverage": "node tools/coverage.js",
    "coverage:all": "node tools/coverage.js --e2e",
    "format": "prettier --write .",
    "icons": "node tools/make-icons.js",
    "sites": "node tools/sync-sites.js",
    "package": "node tools/package.js",
    "site-check": "node tools/site-check.js",
    "site-check:hosts": "node tools/site-check.js --hosts",
    "check": "npm test && npm run lint && npm run test:e2e && npm run test:e2e:all-on && npm run test:firefox -- --if-installed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "fast-check": "4.10.2",
    "globals": "^17.12.0",
    "prettier": "3.9.9",
    "puppeteer-core": "^25.12.0"
  }
}
