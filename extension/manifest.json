{
  "manifest_version": 3,
  "name": "Clotr: AI chat privacy, clot your data leaks",
  "short_name": "Clotr",
  "version": "1.6.4",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon-on-16.png",
    "32": "icons/icon-on-32.png",
    "48": "icons/icon-on-48.png",
    "128": "icons/icon-on-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "declarativeContent",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://notebooklm.google.com/*",
    "https://notebook.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://copilot.com/*",
    "https://www.copilot.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://chat.deepseek.com/*",
    "https://chat.mistral.ai/*",
    "https://grok.com/*",
    "https://www.meta.ai/*",
    "https://poe.com/*",
    "https://huggingface.co/chat/*",
    "https://chat.qwen.ai/*",
    "https://www.kimi.com/*",
    "https://pi.ai/*",
    "https://character.ai/*",
    "https://arena.ai/*",
    "https://lmarena.ai/*",
    "https://duck.ai/*"
  ],
  "optional_permissions": [
    "management",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "clotr_features": {
    "tourniquet": true,
    "lookback": false,
    "extcheck": false,
    "scamcheck": true,
    "commandcheck": true,
    "practice": true,
    "training": false,
    "checkup": false,
    "oneclotr": false
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Clotr",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-off-16.png",
      "32": "icons/icon-off-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://www.copilot.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://grok.com/*",
        "https://www.meta.ai/*",
        "https://poe.com/*",
        "https://huggingface.co/chat/*",
        "https://chat.qwen.ai/*",
        "https://www.kimi.com/*",
        "https://pi.ai/*",
        "https://character.ai/*",
        "https://arena.ai/*",
        "https://lmarena.ai/*",
        "https://duck.ai/*"
      ],
      "js": [
        "engine/rules/value-checks.js",
        "engine/rules/translations.js",
        "engine/rules/numbers/number-words.js",
        "engine/rules/numbers/number-shapes.js",
        "engine/rules/numbers/number-runs.js",
        "engine/rules/personal/email-addresses.js",
        "engine/rules/sentence-ends.js",
        "engine/rules/personal/street-addresses.js",
        "engine/rules/personal/birth-dates.js",
        "engine/rules/ids-and-accounts/labelled-values.js",
        "engine/rules/ids-and-accounts/vehicles-and-student-ids.js",
        "engine/rules/personal/gamer-tags.js",
        "engine/rules/ids-and-accounts/ibans.js",
        "engine/rules/ids-and-accounts/national-id-check-digits.js",
        "engine/rules/personal/own-ip-address.js",
        "engine/rules/ids-and-accounts/spanish-labelled-ids.js",
        "engine/rules/ids-and-accounts/bank-accounts.js",
        "engine/rules/numbers/number-context.js",
        "engine/rules/numbers/social-security-numbers.js",
        "engine/rules/ids-and-accounts/licenses-and-health-ids.js",
        "engine/rules/ids-and-accounts/national-ids.js",
        "engine/rules/numbers/phone-numbers.js",
        "engine/rules/numbers/payment-cards.js",
        "engine/rules/key-formats/crypto-wallets.js",
        "engine/rules/key-formats/private-keys.js",
        "engine/rules/key-formats/two-step-keys.js",
        "engine/rules/personal/link-tracking-codes.js",
        "engine/rules/key-formats/developer-secrets.js",
        "engine/vault/saved-phrases.js",
        "engine/vault/vault-unescape.js",
        "engine/vault/cjk-word-edges.js",
        "engine/vault/saved-words.js",
        "engine/rules/passwords-and-codes/backup-codes.js",
        "engine/rules/passwords-and-codes/secret-values.js",
        "engine/rules/passwords-and-codes/codes-in-messages.js",
        "engine/rules/passwords-and-codes/gift-cards.js",
        "engine/rules/api-tokens/provider-tokens.js",
        "engine/rules/passwords-and-codes/setting-names.js",
        "engine/rules/passwords-and-codes/secret-label-words.js",
        "engine/rules/passwords-and-codes/code-or-prose.js",
        "engine/rules/passwords-and-codes/secrets-in-messages.js",
        "engine/rules/passwords-and-codes/passwords-in-code-and-tables.js",
        "engine/rules/passwords-and-codes/scam-requests.js",
        "engine/rules/passwords-and-codes/camel-case-settings.js",
        "engine/rules/passwords-and-codes/setting-values.js",
        "engine/rules/api-tokens/service-tokens.js",
        "engine/rules/passwords-and-codes/secret-reader.js",
        "engine/rules/rule-table.js",
        "engine/detect/attachment-text.js",
        "engine/detect/cleaned-text.js",
        "engine/detect/second-readings.js",
        "engine/detect/pieced-keys.js",
        "engine/respond/responses.js",
        "engine/respond/fingerprints.js",
        "engine/respond/cover-values.js",
        "engine/respond/generalize.js",
        "engine/respond/bandage-labels.js",
        "engine/detect/detect.js",
        "engine/respond/decide.js",
        "on-websites/attached-files.js",
        "on-websites/attached-pictures.js",
        "commands.js",
        "on-websites/warning-styles.js",
        "on-websites/chat-box.js",
        "on-websites/warning-ui.js",
        "on-websites/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "focus-notice": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "__MSG_cmdFocusNotice__"
    }
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "default_locale": "en"
}
